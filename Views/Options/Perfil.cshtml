@model VEMOS.Models.Usuario

@{
    ViewData["Title"] = "Perfil";
}

<body>
    <section class = "username">
        <h1>Bienvenido, @ViewBag.Usuario.username</h1>
    </section>
    <section class="user-info">
        <h2>Información del usuario</h2>
        <p><strong>Nombre completo:</strong> @ViewBag.Usuario.nombre</p>
        <p><strong>Apellido:</strong> @ViewBag.Usuario.apellido</p>
        <p><strong>Email:</strong> @ViewBag.Usuario.email</p>
</body>