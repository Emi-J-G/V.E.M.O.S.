﻿@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";
}

<section class="landing-content">
    <h1>VEMOS QUE TE OFRECEMOS</h1>

    <section class="offer-row">
        <div class="map-card preview-map-left">
            <div class="map-surface map-small">
                <div class="cta-bubble">INICIAR SESIÓN</div>
            </div>
        </div>

        <div class="map-card preview-map-right">
            <div class="map-surface map-large"></div>
        </div>
    </section>

    <div class="tab-section-shell">
        <nav class="tab-bar" aria-label="Navegación principal">
            <button class="tab">RESTAURANTES</button>
            <button class="tab">MAPA</button>
            <button class="tab">RESEÑAS</button>
        </nav>
    </div>

    <section class="desktop-panel">
        <div class="panel-inner">
            <button class="arrow left" aria-label="Anterior"><</button>
            <div class="circle"></div>
            <button class="arrow right" aria-label="Siguiente">></button>
        </div>
    </section>
</section>
