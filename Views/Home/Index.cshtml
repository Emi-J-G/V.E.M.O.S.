﻿@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";
}

@if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
{
    <div class="auth-banner-message" role="alert">@ViewBag.Mensaje</div>
}

<div class="auth-modal-backdrop" id="login-modal" aria-hidden="true">
    <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="login-title">
        <div class="login-card auth-modal-card">
            <button type="button" class="auth-modal-close" aria-label="Cerrar">×</button>

            <h1 class="auth-title" id="login-title">Iniciar sesión</h1>

            @if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
            {
                <p class="auth-message">@ViewBag.Mensaje</p>
            }

            <form class="login-form" action='@Url.Action("Loguear", "LoginRegis")' method="POST">
                <input class="auth-input" type="text" name="nombreUsuario" placeholder="Nombre de usuario" required />
                <input class="auth-input" type="password" name="contrasena" placeholder="Contraseña" required />
                <button class="auth-submit" type="submit">Ingresar</button>
            </form>

            <div class="auth-divider">
                <span>Otras opciones</span>
            </div>

            <div class="auth-alt-actions">
                <button type="button" class="auth-link auth-switch-trigger" data-auth-modal="register-modal">Registrarse</button>
                <a href="@Url.Action("GoogleLogin", "LoginRegis")" class="auth-google" type="button">Iniciar sesión con Google</a>
            </div>
        </div>
    </div>
</div>

<div class="auth-modal-backdrop" id="register-modal" aria-hidden="true">
    <div class="auth-modal auth-modal-large" role="dialog" aria-modal="true" aria-labelledby="register-title">
        <div class="login-card register-card auth-modal-card">
            <button type="button" class="auth-modal-close" aria-label="Cerrar">×</button>
            <h1 class="auth-title" id="register-title">Registrarse</h1>

            @if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
            {
                <p class="auth-message">@ViewBag.Mensaje</p>
            }

            <form class="login-form register-form" action='@Url.Action("Registrar", "LoginRegis")' method="POST" onsubmit="return validateRegisterForm();">
                <div class="register-layout">
                    <div class="register-fields">
                        <label class="sr-only" for="nombreUsuario">Nombre de usuario</label>
                        <input class="auth-input" type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Username" autocomplete="username" required />
                        <label class="sr-only" for="nombre">Nombre</label>
                        <input class="auth-input" type="text" id="nombre" name="nombre" placeholder="Nombre" autocomplete="given-name" required />
                        <label class="sr-only" for="apellido">Apellido</label>
                        <input class="auth-input" type="text" id="apellido" name="apellido" placeholder="Apellido" autocomplete="family-name" required />
                        <label class="sr-only" for="contrasena">Contraseña</label>
                        <input class="auth-input" type="password" id="contrasena" name="contrasena" placeholder="Contraseña" autocomplete="new-password" required />
                        <label class="sr-only" for="email">Correo electrónico</label>
                        <input class="auth-input" type="email" id="email" name="email" placeholder="Correo electrónico" autocomplete="email" required />

                        <label class="sr-only" for="tipo">Tipo de cuenta</label>
                        <select class="auth-select" id="tipo" name="tipo" aria-label="Tipo de cuenta">
                            <option value="Cliente">Cliente</option>
                            <option value="Restaurante">Restaurante</option>
                        </select>

                        <button class="auth-submit" type="submit">Registrarse</button>
                    </div>

                    <div class="register-restrictions-wrap">
                        <fieldset class="restrictions-box">
                            <legend>Restricciones alimenticias</legend>
                            <div class="restrictions-grid">
                                <label><input type="checkbox" name="restricciones" value="Celiaquía" /> <span>Celiaquía</span></label>
                                <label><input type="checkbox" name="restricciones" value="Diabetes" /> <span>Diabetes</span></label>
                                <label><input type="checkbox" name="restricciones" value="Kosher" /> <span>Kosher</span></label>
                                <label><input type="checkbox" name="restricciones" value="Halal" /> <span>Halal</span></label>
                                <label><input type="checkbox" name="restricciones" value="Lactosa" /> <span>Lactosa</span></label>
                                <label><input type="checkbox" name="restricciones" value="Vegano" /> <span>Vegano</span></label>
                                <label><input type="checkbox" name="restricciones" value="Vegetariano" /> <span>Vegetariano</span></label>
                                <label><input type="checkbox" name="restricciones" value="Alergias" /> <span>Alergias</span></label>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </form>

            <div class="auth-divider">
                <span>Otras opciones</span>
            </div>

            <div class="auth-alt-actions">
                <a href="@Url.Action("GoogleLogin", "LoginRegis")" class="auth-google" type="button"><span class="google-mark" aria-hidden="true">G</span>Continuar con Google</a>
                <button type="button" class="auth-link auth-switch-trigger" data-auth-modal="login-modal">Iniciar sesión</button>
            </div>
        </div>
    </div>
</div>

<section class="landing-hero" id="inicio">
    <div class="hero-copy">
        <div class="pill-badge">
            <span class="pill-icon">♡</span>
            <span>Comer afuera también es para vos</span>
        </div>

        <h1>
            Encontrá lugares<br />
            para comer sin<br />
            preocupaciones
        </h1>

        <div class="hero-divider"></div>

        <p>
            Buscá restaurantes que se adapten a tus necesidades alimentarias.<br />
            Descubrí opciones, consultá información y elegí con más tranquilidad.
        </p>

        <div class="search-strip">
            <div class="search-input-wrap">
                <span class="search-icon"><img src="~/Logos/busqueda.png" alt="Buscar" /></span>
                <input type="text" placeholder="Buscar un restaurante o un barrio..." aria-label="Buscar restaurante o barrio" />
            </div>
            <button type="button" aria-label="Buscar">→</button>
        </div>

        <div class="need-label">Explorá según tus necesidades:</div>

        <div class="restriction-list">
            <label class="chip"><p>Sin TACC</p></label>
            <label class="chip"><p>Sin lactosa</p></label>
            <label class="chip"><p>Vegetariano</p></label>
            <label class="chip"><p>Vegano</p></label>
        </div>
    </div>

    <div class="hero-visual">
        <div class="visual-card">
            <div class="float-badge">Todas los lugares.<br />Todas las personas.</div>

            <div class="store-panel">
                <img src="~/Images/arturito.jpg" alt="Arturito" />
            </div>

            <div class="simple-filter">
                <div class="mini-check"></div>
                <div class="simple-copy">
                    <strong>Filtrá de forma simple</strong>
                    <span>Opciones según tus preferencias</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="landing-features" aria-label="Beneficios de V.E.M.O.S.">
    <article class="feature-card">
        <div class="feature-icon icon-map" aria-hidden="true"></div>
        <div class="feature-text">
            <h2>Explorá</h2>
            <p>Encontrá restaurantes<br />en tu zona.</p>
        </div>
    </article>
    <article class="feature-card">
        <div class="feature-icon icon-filter" aria-hidden="true"></div>
        <div class="feature-text">
            <h2>Filtrá</h2>
            <p>Elegí según tus<br />necesidades alimentarias.</p>
        </div>
    </article>
    <article class="feature-card">
        <div class="feature-icon icon-star" aria-hidden="true"></div>
        <div class="feature-text">
            <h2>Descubrí</h2>
            <p>Consultá menús e<br />información del lugar.</p>
        </div>
    </article>
    <article class="feature-card">
        <div class="feature-icon icon-share" aria-hidden="true"></div>
        <div class="feature-text">
            <h2>Compartí</h2>
            <p>Ayudá con reseñas<br />y experiencias.</p>
        </div>
    </article>
</section>

<section class="discover-section" id="descubri" aria-label="Descubrir lugares para comer">
    <div class="discover-intro">
        <h1>Descubrí dónde comer</h1>
        <p>Explorá los lugares disponibles y elegí los filtros que necesites.</p>
    </div>

    <div class="discover-layout">
        <div class="map-panel" aria-label="Mapa de restaurantes">
            <div class="map-search-pill">
                <span class="map-search-icon">◎</span>
                <span>Explorá cerca tuyo</span>
            </div>

            <div class="map-surface">
                <button type="button" class="map-button">Ver mapa completo <span aria-hidden="true">→</span></button>
            </div>
        </div>

        <div class="discover-cards">
            <h2>Lugares para descubrir</h2>
            <p>Ejemplos visuales para el prototipo</p>

            <div class="suggestions-grid">
                <article class="mini-card">
                    <div class="card-photo">
                        <img src="~/Images/plato-1.png" alt="Plato de comida sin TACC" />
                    </div>
                    <div class="card-body">
                        <h3>Sin TACC</h3>
                        <p>Encontrá opciones sin TACC</p>
                    </div>
                </article>

                <article class="mini-card">
                    <div class="card-photo">
                        <img src="~/Images/plato-2.png" alt="Plato de comida vegetariana" />
                    </div>
                    <div class="card-body">
                        <h3>Opciones vegetarianas</h3>
                        <p>Descubrí propuestas para vos.</p>
                    </div>
                </article>

                <article class="mini-card">
                    <div class="card-photo">
                        <img src="~/Images/plato-3.png" alt="Plato de comida vegana" />
                    </div>
                    <div class="card-body">
                        <h3>Sin lactosa</h3>
                        <p>Buscá sin lactosa y filtrá de acuerdo con tus preferencias.</p>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="how-section" id="como-funciona" aria-label="Cómo funciona V.E.M.O.S.">
    <div class="how-header">
        <h2>¿Cómo funciona V.E.M.O.S.?</h2>
        <p>En tres pasos, encontrá opciones que se adapten a vos.</p>
    </div>

    <div class="steps-grid">
        <article class="step-card">
            <div class="step-card-header">
                <div class="step-index">01</div>
                <h3>Elegí tus filtros</h3>
            </div>
            <p>Seleccioná las restricciones o preferencias alimentarias que necesites.</p>
        </article>

        <article class="step-card">
            <div class="step-card-header">
                <div class="step-index">02</div>
                <h3>Explorá en el mapa</h3>
            </div>
            <p>Encontrá opciones gastronómicas y consultá la ubicación.</p>
        </article>

        <article class="step-card">
            <div class="step-card-header">
                <div class="step-index">03</div>
                <h3>Conocé cada lugar</h3>
            </div>
            <p>Revisá el menú, los detalles y las experiencias de otros usuarios.</p>
        </article>
    </div>
</section>
<section class="signup-section" aria-label="Crear una cuenta">
    <div class="signup-content">
        <h2>Tu próxima salida comienza acá</h2>
        <p>Creá tu cuenta y empezá a navegar por el mapa sin costo.</p>
        <a class="cta-button" href="/LoginRegis/Registro">Crear una cuenta</a>
    </div>

    <div class="signup-card" aria-label="Todos los lugares. Todas las personas.">
        <p>Todos los lugares.<br />Todas las personas.</p>
        <span>V.E.M.O.S.</span>
    </div>
</section>

<script>
    // Smooth scrolling for navigation links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();

            document.querySelector(this.getAttribute('href')).scrollIntoView({
                behavior: 'smooth'
            });
        });
    });
</script>
