﻿@{
    Layout = "_Layout";
    ViewData["Title"] = "Inicio";
}

<section class="landing-hero">
    <div class="hero-copy">
        <div class="pill-badge">
            <span class="pill-icon">♡</span>
            <span>Comer afuera también es para vos</span>
        </div>

        <h1>
            Encontrá lugares<br />
            para comer sin<br />
            preocupaciones
        </h1>

        <div class="hero-divider"></div>

        <p>
            Buscá restaurantes que se adapten a tus necesidades alimentarias.<br />
            Descubrí opciones, consultá información y elegí con más tranquilidad.
        </p>

        <div class="search-strip">
            <div class="search-input-wrap">
                <span class="search-icon">⌕</span>
                <input type="text" placeholder="Buscar un restaurante o un barrio..." aria-label="Buscar restaurante o barrio" />
            </div>
            <button type="button" aria-label="Buscar">→</button>
        </div>

        <div class="need-label">Explorá según tus necesidades:</div>

        <div class="restriction-list">
            <label class="chip"><input type="checkbox" checked /> Sin TACC</label>
            <label class="chip"><input type="checkbox" checked /> Sin lactosa</label>
            <label class="chip"><input type="checkbox" checked /> Vegetariano</label>
            <label class="chip"><input type="checkbox" checked /> Vegano</label>
        </div>
    </div>

    <div class="hero-visual">
        <div class="visual-card">
            <div class="float-badge">Todas los lugares.<br />Todas las personas.</div>

            <div class="store-panel">
                <div class="store-sign">artunto</div>
            </div>

            <div class="simple-filter">
                <div class="mini-check"></div>
                <div class="simple-copy">
                    <strong>Filtrá de forma simple</strong>
                    <span>Opciones según tus preferencias</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="discover-section" aria-label="Descubrir lugares para comer">
    <div class="discover-intro">
        <h1>Descubrí dónde comer</h1>
        <p>Explorá los lugares disponibles y elegí los filtros que necesites.</p>
    </div>

    <div class="discover-layout">
        <div class="map-panel" aria-label="Mapa de restaurantes">
            <div class="map-search-pill">
                <span class="map-search-icon">◎</span>
                <span>Explorá cerca tuyo</span>
            </div>

            <div class="map-surface">
                <button type="button" class="map-button">Ver mapa completo <span aria-hidden="true">→</span></button>
            </div>
        </div>

        <div class="discover-cards">
            <h2>Lugares para descubrir</h2>
            <p>Ejemplos visuales para el prototipo</p>

            <div class="suggestions-grid">
                <article class="mini-card">
                    <div class="card-photo food-one"></div>
                    <div class="card-body">
                        <h3>Sin TACC</h3>
                        <p>Encontrá opciones sin TACC</p>
                    </div>
                </article>

                <article class="mini-card">
                    <div class="card-photo food-two"></div>
                    <div class="card-body">
                        <h3>Vegetariano</h3>
                        <p>Opciones vegetarianas</p>
                    </div>
                </article>

                <article class="mini-card">
                    <div class="card-photo food-three"></div>
                    <div class="card-body">
                        <h3>Sin lactosa</h3>
                        <p>Buscá sin lactosa</p>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="how-section" aria-label="Cómo funciona V.E.M.O.S.">
    <div class="how-header">
        <h2>¿Cómo funciona V.E.M.O.S.?</h2>
        <p>En tres pasos, encontrá opciones que se adapten a vos.</p>
    </div>

    <div class="steps-grid">
        <article class="step-card">
            <div class="step-card-header">
                <div class="step-index">01</div>
                <h3>Elegí tus filtros</h3>
            </div>
            <p>Seleccioná las restricciones o preferencias alimentarias que necesites.</p>
        </article>

        <article class="step-card">
            <div class="step-card-header">
                <div class="step-index">02</div>
                <h3>Explorá en el mapa</h3>
            </div>
            <p>Encontrá opciones gastronómicas y consultá la ubicación.</p>
        </article>

        <article class="step-card">
            <div class="step-card-header">
                <div class="step-index">03</div>
                <h3>Conocé cada lugar</h3>
            </div>
            <p>Revisá el menú, los detalles y las experiencias de otros usuarios.</p>
        </article>
    </div>
</section>
