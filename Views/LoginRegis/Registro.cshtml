@{
    ViewData["Title"] = "Registro";
}

<div class="text-center">
    @if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
    {
        <p>@ViewBag.Mensaje</p>
    }
    <h1 class="display-4">Registro de usuario</h1>

    <form action='@Url.Action("Registrar", "LoginRegis")' method="POST" onsubmit="return validateRegisterForm();">
        <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Ingrese su nombre de usuario" required />
        <input type="text" id="nombre" name="nombre" placeholder="Ingrese su nombre" required />
        <input type="text" id="apellido" name="apellido" placeholder="Ingrese su apellido" required />
        <input type="password" id="contrasena" name="contrasena" placeholder="Ingrese su contraseña" required />
        <input type="email" id="email" name="email" placeholder="Ingrese su correo electrónico" required />
        <select id="tipo" name="tipo">
            <option value="Cliente">Cliente</option>
            <option value="Restaurante">Restaurante</option>
        </select>
        <div>
            <label><input type="checkbox" name="restricciones" value="Celiaquía" /> Celiaquía</label>
            <label><input type="checkbox" name="restricciones" value="Diabetes" /> Diabetes</label>
            <label><input type="checkbox" name="restricciones" value="Kosher" /> Kosher</label>
            <label><input type="checkbox" name="restricciones" value="Halal" /> Halal</label>
            <label><input type="checkbox" name="restricciones" value="Lactosa" /> Lactosa</label>
            <label><input type="checkbox" name="restricciones" value="Vegano" /> Vegano</label>
            <label><input type="checkbox" name="restricciones" value="Vegetariano" /> Vegetariano</label>
            <label><input type="checkbox" name="restricciones" value="Alergias" /> Alergias</label>
        </div>
        <input type="submit" value="Registrarse" />
    </form>
    <a href="@Url.Action("Login", "LoginRegis")">Iniciar sesión</a>
</div>