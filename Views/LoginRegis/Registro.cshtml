@{
    ViewData["Title"] = "Registrarse";
}

<div class="auth-page register-page">
    <div class="login-card register-card">
        <h1 class="auth-title">@ViewData["Title"]</h1>

        @if (!string.IsNullOrEmpty(ViewBag.Mensaje as string))
        {
            <p class="auth-message">@ViewBag.Mensaje</p>
        }

        <form class="login-form register-form" action='@Url.Action("Registrar", "LoginRegis")' method="POST" onsubmit="return validateRegisterForm();">
            <label class="sr-only" for="nombreUsuario">Nombre de usuario</label>
            <input class="auth-input" type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Username" autocomplete="username" required />
            <label class="sr-only" for="nombre">Nombre</label>
            <input class="auth-input" type="text" id="nombre" name="nombre" placeholder="Nombre" autocomplete="given-name" required />
            <label class="sr-only" for="apellido">Apellido</label>
            <input class="auth-input" type="text" id="apellido" name="apellido" placeholder="Apellido" autocomplete="family-name" required />
            <label class="sr-only" for="contrasena">Contraseña</label>
            <input class="auth-input" type="password" id="contrasena" name="contrasena" placeholder="Contraseña" autocomplete="new-password" required />
            <label class="sr-only" for="email">Correo electrónico</label>
            <input class="auth-input" type="email" id="email" name="email" placeholder="Correo electrónico" autocomplete="email" required />

            <label class="sr-only" for="tipo">Tipo de cuenta</label>
            <select class="auth-select" id="tipo" name="tipo" aria-label="Tipo de cuenta">
                <option value="Cliente">Cliente</option>
                <option value="Restaurante">Restaurante</option>
            </select>

            <fieldset class="restrictions-box">
                <legend>Restricciones alimenticias</legend>
                <div class="restrictions-grid">
                    <label><input type="checkbox" name="restricciones" value="Celiaquía" /> <span>Celiaquía</span></label>
                    <label><input type="checkbox" name="restricciones" value="Diabetes" /> <span>Diabetes</span></label>
                    <label><input type="checkbox" name="restricciones" value="Kosher" /> <span>Kosher</span></label>
                    <label><input type="checkbox" name="restricciones" value="Halal" /> <span>Halal</span></label>
                    <label><input type="checkbox" name="restricciones" value="Lactosa" /> <span>Lactosa</span></label>
                    <label><input type="checkbox" name="restricciones" value="Vegano" /> <span>Vegano</span></label>
                    <label><input type="checkbox" name="restricciones" value="Vegetariano" /> <span>Vegetariano</span></label>
                    <label><input type="checkbox" name="restricciones" value="Alergias" /> <span>Alergias</span></label>
                </div>
            </fieldset>

            <button class="auth-submit" type="submit">Registrarse</button>
        </form>

        <div class="auth-divider auth-divider-inline">
            <span>Otras opciones</span>
        </div>

        <div class="auth-alt-actions auth-inline-actions">
            <button class="auth-google" type="button"><span class="google-mark" aria-hidden="true">G</span>Continuar con Google</button>
            <a class="auth-link" href="@Url.Action("Login", "LoginRegis")">Iniciar sesión</a>
        </div>
    </div>
</div>